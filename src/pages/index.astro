---
import Layout from '../layouts/Layout.astro';
import Mujer from '../components/Mujer.astro';
import Hombre from '../components/Hombre.astro';
---

<Layout>
  <div class="contenedor-categorias">
    <Mujer />
    <Hombre />
  </div>
</Layout>

<style>
  body {
    margin: 0;
  }

  .contenedor-categorias {
    display: flex;
    width: 100%;
    min-height: 100vh;
  }
</style>